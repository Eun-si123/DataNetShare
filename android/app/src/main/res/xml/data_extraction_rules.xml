<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ may permit device-to-device transfer even with allowBackup=false.
     Do not migrate app-private data, including Keystore-bound Wi-Fi credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
