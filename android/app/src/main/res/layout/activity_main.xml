<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#0F1419">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DataNet Share" android:textColor="#E6E8EB"
            android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/tagline" android:textColor="#B5BCC8"
            android:textSize="14sp" android:layout_marginBottom="16dp"/>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/idle"
            android:textColor="#4ADE80" android:textSize="20sp" android:textStyle="bold"
            android:accessibilityLiveRegion="polite"/>
        <TextView android:id="@+id/detailsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#E6E8EB"
            android:textSize="14sp" android:layout_marginTop="8dp"/>
        <TextView android:id="@+id/statsText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B5BCC8"
            android:textSize="13sp" android:layout_marginBottom="12dp"/>

        <!-- Choose the role before connecting; hide the selector while a session runs. -->
        <TextView android:id="@+id/modeLabel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/select_role"
            android:textColor="#E6E8EB" android:textStyle="bold"/>
        <RadioGroup android:id="@+id/roleGroup" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp">
            <RadioButton android:id="@+id/roleShare" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="48dp" android:gravity="center_vertical"
                android:text="@string/role_share" android:textColor="#FFFFFF"
                android:buttonTint="#60A5FA"/>
            <RadioButton android:id="@+id/roleReceive" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:minHeight="48dp" android:gravity="center_vertical"
                android:text="@string/role_receive" android:textColor="#FFFFFF"
                android:buttonTint="#60A5FA"/>
        </RadioGroup>
        <Button android:id="@+id/btnConnect" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="56dp"
            android:text="@string/start_p2p" android:backgroundTint="#2563EB"
            android:textColor="#FFFFFF"/>

        <!-- Only the chosen role's configuration appears, not two long forms. -->
        <LinearLayout android:id="@+id/senderSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="10dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/sender_mode_label" android:textColor="#E6E8EB"
                android:textStyle="bold" android:layout_marginTop="8dp"/>
            <RadioGroup android:id="@+id/transportGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <RadioButton android:id="@+id/transportDirect" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/transport_direct" android:textColor="#FFFFFF"
                    android:buttonTint="#60A5FA"/>
                <RadioButton android:id="@+id/transportLocal" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/transport_local" android:textColor="#FFFFFF"
                    android:buttonTint="#60A5FA"/>
            </RadioGroup>
            <LinearLayout android:id="@+id/localSettings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/bind_label" android:labelFor="@id/bindAddress"
                    android:textColor="#B5BCC8" android:layout_marginTop="8dp"/>
                <Spinner android:id="@+id/bindAddress" android:layout_width="match_parent"
                    android:layout_height="48dp" android:backgroundTint="#B5BCC8"/>
                <Button android:id="@+id/btnRefresh" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/refresh"/>
            </LinearLayout>
            <Button android:id="@+id/btnAdvanced" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/advanced_show"/>
            <LinearLayout android:id="@+id/advancedSettings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:background="#1F2937" android:padding="12dp">
                <Switch android:id="@+id/defaultRoute" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/default_route" android:textColor="#E6E8EB"
                    android:textSize="14sp"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/route_help" android:textColor="#B5BCC8"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/receiverSettings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="12dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/receiver_heading" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/qr_import_help" android:textColor="#B5BCC8"
                android:textSize="13sp" android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnScanQr" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="52dp"
                android:text="@string/scan_pairing_qr"/>
            <TextView android:id="@+id/scanStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/qr_not_scanned"
                android:textColor="#B5BCC8" android:textSize="13sp"
                android:layout_marginBottom="8dp" android:layout_marginTop="4dp"/>
            <LinearLayout android:id="@+id/scannedWifiPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone" android:background="#1F2937" android:padding="12dp">
                <TextView android:id="@+id/scannedWifiText" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textIsSelectable="true"/>
                <Button android:id="@+id/btnCopyWifi" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/copy_scanned_wifi_password"/>
                <Button android:id="@+id/btnWifiSettings" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:text="@string/open_wifi_settings"/>
            </LinearLayout>
            <Button android:id="@+id/btnManual" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/manual_show"/>
            <LinearLayout android:id="@+id/manualSettings" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/receiver_help" android:textColor="#B5BCC8"
                    android:textSize="13sp" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/receiverHost" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:hint="@string/host_hint" android:inputType="numberDecimal"
                    android:digits="0123456789." android:singleLine="true"
                    android:textColor="#FFFFFF" android:textColorHint="#B5BCC8"
                    android:importantForAutofill="no"/>
                <EditText android:id="@+id/receiverPort" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:hint="@string/port_hint" android:inputType="number"
                    android:singleLine="true" android:text="8282" android:maxLength="5"
                    android:textColor="#FFFFFF" android:textColorHint="#B5BCC8"
                    android:importantForAutofill="no"/>
                <EditText android:id="@+id/receiverPassword" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:minHeight="48dp"
                    android:hint="@string/password_hint" android:inputType="textPassword"
                    android:singleLine="true" android:maxLength="255"
                    android:saveEnabled="false" android:importantForAutofill="no"
                    android:textColor="#FFFFFF" android:textColorHint="#B5BCC8"/>
            </LinearLayout>
        </LinearLayout>

        <!-- During sharing, show the QR immediately beneath the primary action. -->
        <LinearLayout android:id="@+id/credsCard" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="16dp" android:background="#1E3A5F"
            android:visibility="gone" android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/credentials" android:textColor="#BFDBFE"
                android:textStyle="bold"/>
            <TextView android:id="@+id/credentialsText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FFFFFF"
                android:textSize="15sp" android:fontFamily="monospace"
                android:textIsSelectable="true" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnCopy" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/copy_credentials"/>
            <Button android:id="@+id/btnQr" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/show_pairing_qr"/>
            <LinearLayout android:id="@+id/qrPanel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/qr_sender_help" android:textColor="#E6E8EB"
                    android:textSize="13sp" android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"/>
                <ImageView android:id="@+id/qrImage" android:layout_width="270dp"
                    android:layout_height="270dp" android:layout_gravity="center_horizontal"
                    android:padding="8dp" android:background="#FFFFFF"
                    android:contentDescription="@string/pairing_qr_description"
                    android:importantForAccessibility="yes"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="#1F2937"
            android:padding="12dp" android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/diagnostic_status_title" android:textStyle="bold"
                android:textColor="#FFFFFF" android:textSize="15sp"/>
            <TextView android:id="@+id/diagnosticSummary" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#FDE68A"
                android:textSize="13sp" android:fontFamily="monospace"
                android:textIsSelectable="true" android:layout_marginTop="8dp"/>
            <Button android:id="@+id/btnCopyDiagnostics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/copy_safe_diagnostics"/>
        </LinearLayout>
        <Button android:id="@+id/btnDiagnostics" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:text="@string/diagnostics"/>
        <LinearLayout android:id="@+id/diagnosticsPanel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/diagnostic_status_help" android:textColor="#B5BCC8"
                android:textSize="13sp" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnUdpTest" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/udp_test"/>
            <TextView android:id="@+id/logText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="100dp"
                android:padding="12dp" android:background="#161B22"
                android:textColor="#B5BCC8" android:textSize="12sp"
                android:fontFamily="monospace" android:textIsSelectable="true"/>
        </LinearLayout>
        <TextView android:id="@+id/versionText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B5BCC8"
            android:textSize="12sp" android:layout_marginTop="20dp"/>
    </LinearLayout>
</ScrollView>